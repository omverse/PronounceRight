# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Groq Cloud API (Whisper transcription & AI speech coaching)
GROQ_API_KEY=gsk_your_groq_api_key_here

# (Optional) Local espeak library path if running fallback phonemizer locally
# PHONEMIZER_ESPEAK_LIBRARY=/opt/homebrew/Cellar/espeak/1.48.04_1/lib/libespeak.dylib
